<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="130dp"
    android:background="@drawable/bg_widget"
    android:orientation="horizontal">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.6">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/horseShoe"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="10dp"
                android:contentDescription="@string/horseshoe_image_view"
                android:padding="15dp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/trophy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/small_empty_trophy"
                android:backgroundTint="@color/black"
                android:contentDescription="@string/trophy_image_view"
                android:scaleX="0.55"
                android:scaleY="0.55" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/updatedAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                app:fontFamily="@font/roboto_regular"
                android:fontFamily="@font/roboto_regular"
                android:textColor="@color/black"
                android:textSize="10dp"
                tools:ignore="SmallSp,SpUsage"
                tools:text="Update at: 12:23" />
        </FrameLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.4"
        android:background="@drawable/bg_widget_grey"
        android:gravity="center"
        android:orientation="vertical"
        android:weightSum="10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/xTimes"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/BU_20"
                app:fontFamily="@font/roboto_bold"
                android:fontFamily="@font/roboto_bold"
                android:gravity="bottom"
                android:textColor="@color/black"
                android:textSize="26dp"
                tools:ignore="SpUsage"
                tools:text="x3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                app:fontFamily="@font/roboto_regular"
                android:fontFamily="@font/roboto_regular"
                android:gravity="bottom"
                android:paddingBottom="3dp"
                android:text="@string/active10s"
                android:textColor="@color/black"
                android:textSize="16dp"
                tools:ignore="SpUsage" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/briskMin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                app:fontFamily="@font/roboto_bold"
                android:fontFamily="@font/roboto_bold"
                android:gravity="start"
                android:paddingStart="20dp"
                android:textColor="@color/black"
                android:textSize="24dp"
                tools:ignore="RtlSymmetry,SpUsage"
                tools:text="32" />

            <TextView
                android:id="@+id/totalMin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                app:fontFamily="@font/roboto_bold"
                android:fontFamily="@font/roboto_bold"
                android:gravity="start"
                android:textColor="@color/black"
                android:textSize="24dp"
                tools:ignore="SpUsage"
                tools:text="32" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/briskMinLabel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="bottom"
                android:layout_weight="0.5"
                app:fontFamily="@font/roboto_regular"
                android:fontFamily="@font/roboto_regular"
                android:gravity="start"
                android:paddingStart="20dp"
                android:text="@string/brisk_highlight"
                android:textColor="@color/black"
                android:textSize="14dp"
                tools:ignore="RtlSymmetry,SpUsage" />

            <TextView
                android:id="@+id/totalMinLabel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                app:fontFamily="@font/roboto_regular"
                android:fontFamily="@font/roboto_regular"
                android:gravity="start"
                android:text="@string/total"
                android:textColor="@color/black"
                android:textSize="14dp"
                tools:ignore="SpUsage" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
