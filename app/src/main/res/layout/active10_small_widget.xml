<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="140dp"
    android:layout_height="130dp"
    android:background="@drawable/bg_widget"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.45">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/horseShoe"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/horseshoe_image_view"
                android:paddingTop="10dp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/trophy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:background="@drawable/small_empty_trophy"
                android:backgroundTint="@color/black"
                android:contentDescription="@string/trophy_image_view"
                android:scaleX="0.55"
                android:scaleY="0.55" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/xTimes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="5dp"
                app:fontFamily="@font/roboto_bold"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/black"
                android:textSize="12dp"
                tools:ignore="SpUsage" />
        </FrameLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-5dp"
        android:layout_weight="0.6"
        android:gravity="top"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/briskMin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="20dp"
                android:layout_weight="0.5"
                app:fontFamily="@font/roboto_bold"
                android:fontFamily="@font/roboto_bold"
                android:gravity="center"
                android:lineSpacingExtra="0dp"
                android:textColor="@color/black"
                android:textSize="18dp"
                tools:text="32"
                tools:ignore="SpUsage" />

            <TextView
                android:id="@+id/totalMin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:layout_weight="0.5"
                app:fontFamily="@font/roboto_bold"
                android:fontFamily="@font/roboto_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:textColor="@color/black"
                android:textSize="18dp"
                tools:text="32"
                tools:ignore="SpUsage" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/briskMinLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="0.5"
                app:fontFamily="@font/roboto_regular"
                android:fontFamily="@font/roboto_regular"
                android:gravity="center"
                android:text="@string/brisk_highlight"
                android:textColor="@color/black"
                android:textSize="12dp"
                tools:ignore="SpUsage" />

            <TextView
                android:id="@+id/totalMinLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:layout_weight="0.5"
                app:fontFamily="@font/roboto_regular"
                android:fontFamily="@font/roboto_regular"
                android:gravity="center"
                android:text="@string/total"
                android:textColor="@color/black"
                android:textSize="12dp"
                tools:ignore="SpUsage" />
        </LinearLayout>

        <TextView
            android:id="@+id/updatedAt"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="bottom|center_horizontal"
            app:fontFamily="@font/roboto_regular"
            android:fontFamily="@font/roboto_regular"
            android:gravity="center"
            android:paddingBottom="4dp"
            android:textColor="@color/black"
            android:textSize="8dp"
            tools:text="Updated at: 13:43"
            tools:ignore="SpUsage" />
    </LinearLayout>
</LinearLayout>
