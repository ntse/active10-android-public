<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="screen"
            type="com.flipsidegroup.active10.data.models.api.ScreenContent" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="-24dp"
            android:adjustViewBounds="true"
            android:background="@drawable/background_general_circle"
            android:scaleType="fitStart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/top"
            tools:ignore="ContentDescription"
            tools:src="@drawable/bg_couch_advert" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="?colorPrimary"
            app:layout_constraintBottom_toBottomOf="@id/top"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="0dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/panel_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bh_background_border_radius_top"
            android:backgroundTint="@color/colorPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="@id/guideline">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@id/buttons_container"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <com.phe.betterhealth.widgets.common.HeadingTextView
                        android:id="@+id/header"
                        style="@style/Widget.TextView.Header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="26dp"
                        android:layout_marginTop="40dp"
                        android:text='@{screen.title}'
                        android:textColor="@color/white"
                        android:textSize="34sp"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Download Couch to 5K to start your running journey" />

                    <TextView
                        android:id="@+id/content"
                        style="@style/Widget.TextView.Content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="26dp"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/header"
                        app:textHtml='@{screen.description}'
                        tools:lines="10"
                        tools:text="@tools:sample/lorem/random" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.core.widget.NestedScrollView>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/buttons_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimary"
                android:orientation="vertical"
                android:paddingBottom="10dp"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.phe.betterhealth.widgets.button.BHButton
                    android:id="@+id/continue_button"
                    style="@style/TealButtonLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="26dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:text='@{screen.firstButtonTitle}'
                    android:textColor="@color/colorPrimary"
                    app:backgroundTint="@color/white"
                    app:layout_constraintBottom_toTopOf="@id/close_button"
                    app:layout_constraintVertical_bias="0"
                    tools:text="Start my new plan!" />

                <com.phe.betterhealth.widgets.button.BHButton
                    android:id="@+id/close_button"
                    style="@style/SecondaryButtonLarge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="26dp"
                    android:layout_marginBottom="10dp"
                    android:backgroundTint="@color/white"
                    android:text='@{screen.secondButtonTitle}'
                    android:textColor="@color/white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintVertical_bias="0"
                    tools:text="Continue with this plan" />
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>