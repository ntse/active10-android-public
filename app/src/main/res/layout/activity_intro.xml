<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?colorPrimary"
        app:layout_constraintBottom_toBottomOf="@id/top"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="0dp" />

    <RelativeLayout
        android:id="@+id/containerRL"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        tools:context=".presentation.onboarding.activities.IntroActivity">

        <com.flipsidegroup.active10.utils.NonSwipeableViewPager
            android:id="@+id/introVP"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/continueBTN"
            android:layout_marginTop="?attr/actionBarSize"
            android:layout_marginBottom="26dp" />

        <include
            android:id="@+id/introToolbar"
            layout="@layout/custom_toolbar_white" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/continueBTN"
            style="@style/TealButtonLarge"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="26dp"
            android:clipToPadding="false"
            android:text="@string/button_continue" />
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
