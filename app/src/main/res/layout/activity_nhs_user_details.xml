<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?colorPrimary"
        app:layout_constraintBottom_toBottomOf="@id/top"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="0dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <include
            android:id="@+id/detailsToolbar"
            layout="@layout/custom_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/BU_24"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/updateBTN"
            app:layout_constraintTop_toBottomOf="@id/detailsToolbar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/BU_24"
                android:layout_marginTop="@dimen/BU_24"
                android:clipToPadding="false">

                <com.flipsidegroup.active10.utils.view.HeadingTextView
                    android:id="@+id/userDetailsTitleTV"
                    style="@style/HeaderExtraLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_condensed_bold"
                    android:text="@string/settings_my_details"
                    android:textSize="@dimen/text_size_30"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0" />

                <TextView
                    android:id="@+id/userDetailsDescriptionTV"
                    style="@style/Description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/BU_12"
                    android:gravity="center_horizontal"
                    android:textSize="@dimen/text_size_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/userDetailsTitleTV"
                    tools:text="lorem ipsum dolor amet" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/BU_32"
                    app:layout_constraintTop_toBottomOf="@id/userDetailsDescriptionTV">

                    <com.flipsidegroup.active10.utils.DetailItemLayout
                        android:id="@+id/nameLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:isEditable="false"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:detailLabel="@tools:sample/lorem/random"
                        tools:detailTitle="@tools:sample/lorem"
                        tools:lines="3"
                        tools:visibility="visible" />

                    <com.flipsidegroup.active10.utils.DetailItemLayout
                        android:id="@+id/ageLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/BU_28"
                        app:isEditable="false"
                        app:layout_constraintTop_toBottomOf="@id/nameLayout"
                        tools:detailLabel="@tools:sample/lorem/random"
                        tools:detailTitle="@tools:sample/lorem"
                        tools:lines="3"
                        tools:visibility="visible" />

                    <com.flipsidegroup.active10.utils.DetailItemLayout
                        android:id="@+id/emailLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/BU_28"
                        app:isEditable="false"
                        app:layout_constraintTop_toBottomOf="@id/ageLayout"
                        tools:detailLabel="@tools:sample/lorem/random"
                        tools:detailTitle="@tools:sample/lorem"
                        tools:detailValue="abc@123.com"
                        tools:lines="3"
                        tools:visibility="visible" />

                    <TextView
                        style="@style/Description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineHeight="16sp"
                        android:text="@string/nhs_user_details_description"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/emailLayout" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/updateBTN"
            style="@style/TealButtonLarge"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="@dimen/BU_12"
            android:layout_marginBottom="26dp"
            android:clipToPadding="false"
            android:text="@string/update_your_details"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>