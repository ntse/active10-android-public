<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.progressBar.ProgressBarActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?colorPrimary"
        app:layout_constraintBottom_toBottomOf="@id/top"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="0dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <include
            android:id="@+id/progressBarToolbar"
            layout="@layout/custom_toolbar_white"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressBarToolbar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:paddingHorizontal="@dimen/BU_25"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/progressBarToolbar">

                <ImageView
                    android:id="@+id/progressBarImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_nhs_a10_connect"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/topLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="240dp"
                    app:layout_constraintTop_toBottomOf="@id/progressBarImage"
                    tools:layout_editor_absoluteX="25dp">

                    <TextView
                        android:id="@+id/progressBarTitle"
                        style="@style/HeaderExtraLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:paddingStart="@dimen/margin_size_32"
                        android:paddingEnd="@dimen/margin_size_32"
                        android:text="@string/creating_account"
                        app:layout_constraintBottom_toTopOf="@id/progressLinearLayout"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="spread_inside" />

                    <LinearLayout
                        android:id="@+id/progressLinearLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progressBarTitle">

                        <ProgressBar
                            android:id="@+id/progressBar"
                            style="?android:progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:progressDrawable="@drawable/custom_progress_bar"
                            tools:progress="50" />

                        <TextView
                            android:id="@+id/progressBarPercentage"
                            style="@style/Description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:text="@string/nhs_progress_bar_0_loaded"
                            android:textColor="@color/light_grey_two" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="40dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/topLayout">

                    <TextView
                        android:id="@+id/progressBarDescriptionText1"
                        style="@style/Description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/BU_32"
                        android:layout_marginTop="@dimen/BU_40"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/progressBarDescriptionImage1"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="1dp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/ic_check_list"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/progressBarDescriptionText1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/progressBarDescriptionText1" />

                    <TextView
                        android:id="@+id/progressBarDescriptionText2"
                        style="@style/Description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/BU_32"
                        android:layout_marginTop="@dimen/BU_20"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progressBarDescriptionText1" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/progressBarDescriptionImage2"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="1dp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/ic_check_list"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/progressBarDescriptionText2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/progressBarDescriptionText2" />

                    <TextView
                        android:id="@+id/progressBarDescriptionText3"
                        style="@style/Description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/BU_32"
                        android:layout_marginTop="@dimen/BU_20"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progressBarDescriptionText2" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/progressBarDescriptionImage3"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="1dp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/ic_check_list"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/progressBarDescriptionText3"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/progressBarDescriptionText3" />

                    <TextView
                        android:id="@+id/progressBarDescriptionText4"
                        style="@style/Description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/BU_32"
                        android:layout_marginTop="@dimen/BU_20"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progressBarDescriptionText3" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/progressBarDescriptionImage4"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="1dp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/ic_check_list"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/progressBarDescriptionText4"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/progressBarDescriptionText4" />

                    <TextView
                        android:id="@+id/progressBarDescriptionText5"
                        style="@style/Description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/BU_32"
                        android:layout_marginTop="@dimen/BU_20"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progressBarDescriptionText4" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/progressBarDescriptionImage5"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="1dp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/ic_check_list"
                        app:layout_constraintBottom_toBottomOf="@id/progressBarDescriptionText5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/progressBarDescriptionText5" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>