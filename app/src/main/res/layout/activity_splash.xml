<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background_pink">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?colorPrimary"
        app:layout_constraintBottom_toBottomOf="@id/top"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="0dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:gravity="center"
        android:orientation="vertical"
        tools:context=".presentation.splash.SplashActivity">


        <ImageView
            android:id="@+id/bh_logo"
            android:maxWidth="218dp"
            android:maxHeight="137dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="218:137"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            app:layout_constraintWidth_percent=".33"
            android:contentDescription="@string/bh_logo_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_splash_logo" />

        <ImageView
            android:id="@+id/nhs_logo"
            android:maxWidth="64dp"
            android:maxHeight="23dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintDimensionRatio="64:23"
            android:contentDescription="@string/nhs_logo_description"
            app:layout_constraintWidth_percent=".18"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_logo_nhs" />

        <ImageView
            android:id="@+id/ac10_logo"
            android:maxWidth="270dp"
            android:maxHeight="331dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/ac10_logo_description"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent=".45"
            app:srcCompat="@drawable/ic_logo_ac10"
            app:layout_constraintDimensionRatio="1:1" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
