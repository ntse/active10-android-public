<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?colorPrimary"
        app:layout_constraintBottom_toBottomOf="@id/top"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="0dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <include
            android:id="@+id/setTargetToolbar"
            layout="@layout/custom_toolbar" />

        <include
            android:id="@+id/setTargetWhiteToolbar"
            layout="@layout/custom_toolbar_white" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:fitsSystemWindows="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:context=".presentation.targets.activities.SetTargetActivity">

                <ImageView
                    android:id="@+id/setTargetImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/BU_20"
                    android:background="@drawable/ic_set_target"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.phe.betterhealth.widgets.common.HeadingTextView
                    android:id="@+id/titleTV"
                    style="@style/HeaderExtraLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/BU_20"
                    android:focusableInTouchMode="true"
                    android:gravity="center_horizontal"
                    android:text="@string/target_title"
                    app:layout_constraintTop_toBottomOf="@id/setTargetImage" />

                <TextView
                    android:id="@+id/subtitleTV"
                    style="@style/Description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_horizontal"
                    android:paddingStart="@dimen/BU_50"
                    android:paddingEnd="@dimen/BU_50"
                    android:text="@string/target_subtitle"
                    app:layout_constraintTop_toBottomOf="@id/titleTV" />

                <TextView
                    android:id="@+id/targetActivesTv"
                    style="@style/HeaderMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/BU_20"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/targetContainer2" />

                <LinearLayout
                    android:id="@+id/targetContainer1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/BU_40"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/subtitleTV">

                    <com.flipsidegroup.active10.utils.view.TargetView
                        android:id="@+id/target1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <com.flipsidegroup.active10.utils.view.TargetView
                        android:id="@+id/target2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <com.flipsidegroup.active10.utils.view.TargetView
                        android:id="@+id/target3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/targetContainer2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/targetContainer1">

                    <com.flipsidegroup.active10.utils.view.TargetView
                        android:id="@+id/target4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <com.flipsidegroup.active10.utils.view.TargetView
                        android:id="@+id/target5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <TextView
                    android:id="@+id/targetBenefitTV"
                    style="@style/Description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/BU_10"
                    android:fontFamily="@font/roboto_medium"
                    android:gravity="center"
                    android:padding="25dp"
                    android:text="@string/target_set_benefit"
                    android:textColor="@color/greyish_brown_two"
                    android:textSize="@dimen/text_size_17"
                    app:layout_constraintTop_toBottomOf="@id/targetActivesTv" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/setTargetContinueBTN"
                    style="@style/TealButtonLarge"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="26dp"
                    android:text="@string/button_save_and_continue"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/targetBenefitTV"
                    app:layout_constraintVertical_bias="1" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

