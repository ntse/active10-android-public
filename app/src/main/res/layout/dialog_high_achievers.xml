<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/dialog_high_achievers_card_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="70dp"
        android:background="@drawable/bg_bottomsheet_dialog"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/dialog_high_achievers_icon_background"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="@drawable/white_circle_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/dialog_high_achievers_icon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_high_achievers"
        app:layout_constraintBottom_toBottomOf="@id/dialog_high_achievers_icon_background"
        app:layout_constraintEnd_toEndOf="@id/dialog_high_achievers_icon_background"
        app:layout_constraintStart_toStartOf="@id/dialog_high_achievers_icon_background"
        app:layout_constraintTop_toTopOf="@id/dialog_high_achievers_icon_background" />

    <TextView
        android:id="@+id/dialog_high_achievers_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/roboto_condensed_bold"
        android:text="@string/high_achiever_title"
        android:textColor="@color/black_33"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog_high_achievers_icon" />

    <TextView
        android:id="@+id/dialog_high_achievers_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center"
        android:paddingStart="@dimen/margin_size_32"
        android:paddingEnd="@dimen/margin_size_32"
        android:text="@string/high_achiever_subtitle"
        android:textColor="@color/black_33"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog_high_achievers_title" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/dialog_high_achievers_increase_now_button"
        style="@style/TealButton"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="20dp"
        android:enabled="true"
        android:text="@string/high_achiever_increase_button"
        app:layout_constraintBottom_toTopOf="@id/dialog_high_achievers_maybe_later_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog_high_achievers_subtitle" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/dialog_high_achievers_maybe_later_button"
        style="@style/SecondaryButton"
        android:layout_marginBottom="20dp"
        android:enabled="true"
        android:text="@string/high_achiever_maybe_later_button"
        app:layout_constraintBottom_toTopOf="@id/dialog_high_achievers_dont_ask_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog_high_achievers_increase_now_button" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/dialog_high_achievers_dont_ask_button"
        style="@style/SecondaryButton"
        android:layout_marginBottom="26dp"
        android:text="@string/high_achiever_dont_ask_button"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog_high_achievers_maybe_later_button" />

</androidx.constraintlayout.widget.ConstraintLayout>