<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/dialog_high_achievers_reward_card_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="70dp"
        android:background="@drawable/bg_bottomsheet_dialog"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/dialog_high_achievers_reward_icon_background"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="@drawable/white_circle_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/dialog_high_achievers_reward_icon"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/dialog_high_achievers_reward_icon_background"
        app:layout_constraintEnd_toEndOf="@id/dialog_high_achievers_reward_icon_background"
        app:layout_constraintStart_toStartOf="@id/dialog_high_achievers_reward_icon_background"
        app:layout_constraintTop_toTopOf="@id/dialog_high_achievers_reward_icon_background"
        tools:src="@drawable/ic_trophy_on" />

    <TextView
        android:id="@+id/dialog_high_achievers_reward_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/roboto_condensed_bold"
        android:textColor="@color/black_33"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog_high_achievers_reward_icon"
        tools:text="@string/high_achiever_title" />

    <TextView
        android:id="@+id/dialog_high_achievers_reward_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center"
        android:paddingStart="@dimen/margin_size_32"
        android:paddingEnd="@dimen/margin_size_32"
        android:textColor="@color/black_33"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog_high_achievers_reward_title"
        tools:text="@string/high_achiever_subtitle" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/dialog_high_achievers_reward_close_button"
        style="@style/TealButtonLarge"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="26dp"
        android:enabled="true"
        android:text="@string/button_close"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog_high_achievers_reward_subtitle" />

</androidx.constraintlayout.widget.ConstraintLayout>