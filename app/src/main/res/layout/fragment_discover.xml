<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".presentation.discover.fragments.DiscoverFragment">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?colorPrimary"
        app:layout_constraintBottom_toBottomOf="@id/top"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="0dp" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/discover_toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/top"
        app:title="@string/bottom_nav_menu_discover"
        style="@style/ToolbarBig" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/discover_search_layout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:minHeight="48dp"
        app:boxCornerRadiusBottomEnd="24dp"
        app:boxCornerRadiusBottomStart="24dp"
        app:boxCornerRadiusTopEnd="24dp"
        app:boxCornerRadiusTopStart="24dp"
        app:boxStrokeColor="@color/text_input_box_stroke_color"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1dp"
        app:startIconDrawable="@drawable/ic_search"
        app:endIconMode="clear_text"
        app:hintEnabled="false"
        app:layout_constraintEnd_toStartOf="@id/discover_search_cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/discover_toolbar">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/discover_search_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:hint="Search"
            android:imeOptions="actionDone"
            android:drawablePadding="-8dp"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/bhTextPrimary"
            android:textColorHint="@color/bhTextSecondary" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/discover_search_cancel"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="16dp"
        android:background="?selectableItemBackground"
        android:gravity="center_vertical"
        android:text="Cancel"
        android:textColor="@color/colorPrimary"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/discover_search_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/discover_search_layout" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/discover_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:background="@null"
        app:layout_constraintTop_toBottomOf="@id/discover_search_layout"
        app:tabRippleColor="@null"
        app:tabUnboundedRipple="false"
        app:tabBackground="@android:color/white"
        app:tabIndicatorColor="@color/colorPrimary"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="@color/bhTextPrimary"
        app:tabTextAppearance="@style/TabTextAppearance"
        app:tabTextColor="@color/bhTextSecondary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/discover_recycler_view"
        app:layout_constraintTop_toBottomOf="@id/discover_tabs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="14dp"
        android:background="@color/grey_discovery_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        tools:listitem="@layout/bh_carousel_large"
        />

    <com.flipsidegroup.active10.presentation.common.widgets.ContentLoadingProgressLayout
        android:id="@+id/discover_loading_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/discover_empty_state_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/roboto_bold"
        android:gravity="center_horizontal"
        android:text="Oh no! No results were found.\nPlease try again."
        android:textColor="@color/bhTextPrimary"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/discover_search_layout" />

</androidx.constraintlayout.widget.ConstraintLayout>