<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/titleTV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="30dp"
        android:fontFamily="@font/roboto_condensed_bold"
        android:text="@string/permission_more_about_goals_title"
        android:textColor="@color/greyish_brown"
        android:textSize="@dimen/text_size_23" />

    <FrameLayout
        android:id="@+id/editFL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/titleTV"
        android:layout_marginStart="30dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="30dp">

        <EditText
            android:id="@+id/goalET"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/outline_bg"
            android:gravity="start"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="40dp"
            android:textSize="@dimen/text_size_17"
            tools:text="fasdadsadsad" />

        <TextView
            android:id="@+id/charLimitTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/roboto_medium"
            android:text="@string/goal_character_count"
            android:textColor="@color/greyish_brown"
            android:textSize="@dimen/text_size_12" />

    </FrameLayout>

</RelativeLayout>