<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.stayUpdated.StayUpdatedFragment">

    <ScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/BU_12"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/BU_20"
            android:layout_marginTop="@dimen/BU_20"
            android:paddingBottom="@dimen/BU_20">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/preferences_image"
                android:layout_width="82dp"
                android:layout_height="82dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/ic_ready_to_start" />

            <com.flipsidegroup.active10.utils.view.HeadingTextView
                android:id="@+id/preferences_title"
                style="@style/HeaderExtraLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/BU_20"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@+id/preferences_image"
                tools:text="@string/intro_terms_title" />

            <TextView
                android:id="@+id/preferences_subtitle"
                style="@style/Description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/BU_10"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/preferences_title"
                tools:text="@string/intro_terms_text" />

            <TextView
                android:id="@+id/preferences_list_title"
                style="@style/HeaderMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/BU_60"
                android:paddingVertical="12dp"
                app:layout_constraintTop_toBottomOf="@+id/preferences_subtitle"
                tools:text="@string/intro_terms_title" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/divider_color"
                app:layout_constraintBottom_toBottomOf="@id/preferences_list_title" />

            <com.phe.betterhealth.widgets.checkbox.BHCheckBox
                android:id="@+id/preferences_receive_email"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/roboto_bold"
                android:importantForAccessibility="yes"
                android:paddingVertical="12dp"
                android:textColor="@color/black_33"
                android:textSize="@dimen/text_size_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/preferences_list_title"
                tools:text="@string/intro_terms_and_conditions_large" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
