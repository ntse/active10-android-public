<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/userDetailsParentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/user_data_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/actionButtonsLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/BU_12">

            <ImageView
                android:id="@+id/userDetailsImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ic_select_sex"
                android:contentDescription="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/userDetailsTitleTV"
                style="@style/HeaderExtraLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/BU_12"
                android:layout_marginTop="@dimen/BU_28"
                android:layout_marginEnd="@dimen/BU_12"
                android:contentDescription="@string/about_you_title"
                android:fontFamily="@font/roboto_condensed_bold"
                android:text="@string/about_you_title"
                android:textSize="@dimen/text_size_30"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/userDetailsImageView"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/descriptionTV"
                style="@style/Description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/BU_12"
                android:layout_marginTop="@dimen/BU_20"
                android:layout_marginEnd="@dimen/BU_12"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center_horizontal"
                android:textColor="@color/greyish_brown"
                android:textSize="@dimen/text_size_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/userDetailsTitleTV"
                tools:text="lorem ipsum dolor amet" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/loggedOutUserDetailsLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintTop_toBottomOf="@+id/descriptionTV">

                <TextView
                    android:id="@+id/genderSubtitleTV"
                    style="@style/HeaderMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/BU_12"
                    android:layout_marginTop="@dimen/BU_32"
                    android:layout_marginEnd="@dimen/BU_12"
                    android:text="@string/gender_subtitle"
                    android:accessibilityHeading="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <RadioGroup
                    android:id="@+id/genderRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/BU_12"
                    android:layout_marginTop="@dimen/BU_16"
                    android:layout_marginEnd="@dimen/BU_12"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/genderSubtitleTV">

                    <RadioButton
                        android:id="@+id/maleRB"
                        style="@style/GenderCheckBoxStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.33"
                        android:drawableTop="@drawable/sl_male"
                        android:drawableBottom="@drawable/sl_checkbox_gender"
                        android:drawablePadding="@dimen/BU_8"
                        android:elevation="@dimen/BU_8"
                        android:paddingTop="@dimen/BU_12"
                        android:paddingBottom="@dimen/BU_12"
                        android:text="@string/gender_male"
                        android:textSize="@dimen/BU_16"
                        tools:ignore="SpUsage" />

                    <RadioButton
                        android:id="@+id/femaleRB"
                        style="@style/GenderCheckBoxStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/BU_8"
                        android:layout_weight="0.33"
                        android:drawableTop="@drawable/sl_female"
                        android:drawableBottom="@drawable/sl_checkbox_gender"
                        android:drawablePadding="@dimen/BU_8"
                        android:elevation="@dimen/BU_8"
                        android:paddingTop="@dimen/BU_12"
                        android:paddingBottom="@dimen/BU_12"
                        android:text="@string/gender_female"
                        android:textSize="@dimen/BU_16"
                        tools:ignore="SpUsage" />

                    <RadioButton
                        android:id="@+id/otherRB"
                        style="@style/GenderCheckBoxStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/BU_8"
                        android:layout_weight="0.33"
                        android:drawableBottom="@drawable/sl_checkbox_gender"
                        android:drawablePadding="8dp"
                        android:elevation="@dimen/BU_8"
                        android:gravity="bottom|center_horizontal"
                        android:paddingStart="@dimen/BU_12"
                        android:paddingEnd="@dimen/BU_12"
                        android:paddingBottom="@dimen/BU_12"
                        android:text="@string/gender_other"
                        android:textSize="@dimen/BU_16"
                        tools:ignore="SpUsage" />

                </RadioGroup>

                <TextView
                    android:id="@+id/ageSubtitleTV"
                    style="@style/HeaderMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/BU_12"
                    android:layout_marginTop="@dimen/BU_36"
                    android:layout_marginEnd="@dimen/BU_12"
                    android:contentDescription="@string/age_subtitle"
                    android:text="@string/age_subtitle"
                    android:accessibilityHeading="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/genderRadioGroup" />

                <com.flipsidegroup.active10.utils.FormsInputEditText
                    android:id="@+id/ageEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/BU_12"
                    android:layout_marginEnd="@dimen/BU_12"
                    app:editTextContentDescription="@string/age_subtitle"
                    app:placeholder="Your age"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ageSubtitleTV" />

                <TextView
                    android:id="@+id/activitySubtitleTV"
                    style="@style/HeaderMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/BU_12"
                    android:layout_marginEnd="@dimen/BU_12"
                    android:text="@string/activity_optional"
                    android:accessibilityHeading="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ageEditText" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/inactiveCheckboxLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/BU_12"
                android:layout_marginTop="@dimen/BU_20"
                android:layout_marginEnd="@dimen/BU_12"
                android:clickable="true"
                android:descendantFocusability="blocksDescendants"
                android:focusable="true"
                android:importantForAccessibility="yes"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/loggedOutUserDetailsLayout">

                <TextView
                    android:id="@+id/inactiveCheckboxTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/BU_12"
                    android:fontFamily="@font/roboto_bold"
                    android:importantForAccessibility="no"
                    android:textColor="#1a1a1a"
                    android:textSize="@dimen/text_size_16sp"
                    app:layout_constraintBottom_toTopOf="@id/inactiveCheckboxText"
                    app:layout_constraintEnd_toStartOf="@id/userDetailsNoActiveRB"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/inactiveCheckboxText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/BU_12"
                    android:fontFamily="@font/roboto_regular"
                    android:importantForAccessibility="no"
                    android:textColor="#1a1a1a"
                    android:textSize="@dimen/text_size_16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/userDetailsNoActiveRB"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/inactiveCheckboxTitle" />

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/userDetailsNoActiveRB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/BU_20"
                    android:layout_marginBottom="@dimen/BU_20"
                    android:button="@drawable/radiobutton_background"
                    android:importantForAccessibility="no"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/moderatelyActiveCheckboxLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/BU_12"
                android:layout_marginTop="@dimen/BU_8"
                android:layout_marginEnd="@dimen/BU_12"
                android:clickable="true"
                android:descendantFocusability="blocksDescendants"
                android:focusable="true"
                android:importantForAccessibility="yes"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/inactiveCheckboxLayout">

                <TextView
                    android:id="@+id/moderatelyActiveCheckboxTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/BU_12"
                    android:fontFamily="@font/roboto_bold"
                    android:importantForAccessibility="no"
                    android:textColor="#1a1a1a"
                    android:textSize="@dimen/text_size_16sp"
                    app:layout_constraintBottom_toTopOf="@id/moderatelyActiveCheckboxText"
                    app:layout_constraintEnd_toStartOf="@id/userDetailsModerateActiveRB"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/moderatelyActiveCheckboxText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/BU_12"
                    android:fontFamily="@font/roboto_regular"
                    android:importantForAccessibility="no"
                    android:textColor="#1a1a1a"
                    android:textSize="@dimen/text_size_16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/userDetailsModerateActiveRB"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/moderatelyActiveCheckboxTitle" />

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/userDetailsModerateActiveRB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/BU_20"
                    android:layout_marginBottom="@dimen/BU_20"
                    android:button="@drawable/radiobutton_background"
                    android:importantForAccessibility="no"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/veryActiveCheckboxLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/BU_12"
                android:layout_marginTop="@dimen/BU_8"
                android:layout_marginEnd="@dimen/BU_12"
                android:layout_marginBottom="@dimen/BU_12"
                android:clickable="true"
                android:descendantFocusability="blocksDescendants"
                android:focusable="true"
                android:importantForAccessibility="yes"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/moderatelyActiveCheckboxLayout"
                app:layout_constraintVertical_bias="0.0">

                <TextView
                    android:id="@+id/veryActiveCheckboxTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/BU_12"
                    android:fontFamily="@font/roboto_bold"
                    android:importantForAccessibility="no"
                    android:textColor="#1a1a1a"
                    android:textSize="@dimen/text_size_16sp"
                    app:layout_constraintBottom_toTopOf="@id/veryActiveCheckboxText"
                    app:layout_constraintEnd_toStartOf="@id/userDetailsVeryActiveRB"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/veryActiveCheckboxText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/BU_12"
                    android:fontFamily="@font/roboto_regular"
                    android:importantForAccessibility="no"
                    android:textColor="#1a1a1a"
                    android:textSize="@dimen/text_size_16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/userDetailsVeryActiveRB"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/veryActiveCheckboxTitle" />

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/userDetailsVeryActiveRB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/BU_20"
                    android:layout_marginBottom="@dimen/BU_20"
                    android:button="@drawable/radiobutton_background"
                    android:importantForAccessibility="no"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/divider_color"
                app:layout_constraintTop_toBottomOf="@+id/veryActiveCheckboxLayout" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/divider_color"
                app:layout_constraintTop_toBottomOf="@+id/moderatelyActiveCheckboxLayout" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/divider_color"
                app:layout_constraintTop_toBottomOf="@+id/inactiveCheckboxLayout" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/divider_color"
                app:layout_constraintTop_toTopOf="@+id/inactiveCheckboxLayout" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/actionButtonsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/BU_16"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/addMyDetailsButton"
            style="@style/TealButtonLarge"
            android:layout_marginTop="@dimen/BU_16"
            android:layout_marginBottom="@dimen/BU_12"
            android:enabled="false"
            android:text="@string/save_amp_continue" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/skipButton"
            style="@style/SecondaryButtonLarge"
            android:layout_marginBottom="@dimen/BU_16"
            android:text="@string/button_skip" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
