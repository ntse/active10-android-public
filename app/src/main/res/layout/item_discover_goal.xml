<?xml version="1.0" encoding="utf-8"?>
<com.flipsidegroup.active10.utils.AccessibilityCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containerCV"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    card_view:cardCornerRadius="6dp"
    card_view:cardElevation="4dp"
    card_view:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/goalTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_condensed_bold"
            android:text="@string/health_unlocked_no_goals_set"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_size_15" />

        <TextView
            android:id="@+id/goalDescriptionTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/roboto_condensed_bold"
            android:lines="2"
            android:maxLines="2"
            android:text="@string/health_unlocked_no_goals_set_suggestion"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_16" />

    </LinearLayout>
</com.flipsidegroup.active10.utils.AccessibilityCardView>