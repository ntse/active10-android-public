<?xml version="1.0" encoding="utf-8"?>
<com.flipsidegroup.active10.utils.AccessibilityCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/containerCV"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    card_view:cardCornerRadius="8dp"
    card_view:cardElevation="4dp"
    card_view:cardUseCompatPadding="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/tipIV"
            android:layout_width="match_parent"
            android:layout_height="@dimen/discover_tip_height"
            android:background="@color/colorPrimary"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription"
            tools:src="@drawable/discover_tip_1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tipIV"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tipTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/roboto_condensed_bold"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_16"
                tools:text="What’s new in Active 10" />

            <TextView
                android:id="@+id/descriptionTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/roboto_regular"
                android:lines="3"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_16"
                tools:text="Find out more about the new and improved app. fgb dfdfd fdfdf" />
        </LinearLayout>
    </RelativeLayout>
</com.flipsidegroup.active10.utils.AccessibilityCardView>