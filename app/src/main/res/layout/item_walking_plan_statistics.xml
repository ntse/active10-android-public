<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.flipsidegroup.active10.utils.WalkingPlanState" />

        <import type="android.view.View" />

        <variable
            name="content"
            type="com.flipsidegroup.active10.presentation.walkingplanstatistics.WalkingPlanStatisticsPart.Statistics" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/state_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/active_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility='@{content.state == WalkingPlanState.ACTIVE ? View.VISIBLE : View.GONE}'>

                <include layout="@layout/item_walking_plan_active_state" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/paused_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility='@{content.state == WalkingPlanState.PAUSED ? View.VISIBLE : View.GONE}'>

                <include layout="@layout/item_walking_plan_paused_state" />
            </FrameLayout>
        </FrameLayout>

        <com.phe.betterhealth.widgets.common.HeadingTextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/BU_15"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/roboto_condensed_bold"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text='@{content.planName}'
            android:textColor="@color/black_33"
            android:textSize="18sp"
            android:accessibilityHeading="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/state_container"
            tools:text="Plan name" />

        <TextView
            android:id="@+id/total_weeks_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/BU_15"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/roboto_family"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/black_33"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title"
            tools:text="Week 1 of 6" />

        <androidx.cardview.widget.CardView
            android:id="@+id/statisticsCV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/BU_13"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/BU_13"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="1dp"
            app:cardUseCompatPadding="true"
            app:layout_constraintTop_toBottomOf="@id/total_weeks_counter">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/period_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/period_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:orientation="vertical">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tabGravity="fill"
                    app:tabIndicatorColor="@color/black"
                    app:tabIndicatorHeight="4dp"
                    app:tabMode="auto"
                    app:tabSelectedTextColor="@color/black"
                    app:tabTextAppearance="@style/WalkingPlanTabTextAppearance">

                    <com.google.android.material.tabs.TabItem
                        android:id="@+id/brisk_tab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Brisk target" />

                    <com.google.android.material.tabs.TabItem
                        android:id="@+id/non_brisk_tab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Non-brisk target" />
                </com.google.android.material.tabs.TabLayout>


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/progress_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:paddingTop="25dp"
                    app:layout_constraintTop_toBottomOf="@id/tab_layout">

                    <TextView
                        android:id="@+id/non_brisk_weekly_target"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_condensed_bold"
                        android:text="@string/no_non_brisk_weekly_target"
                        android:textColor="@color/black_33"
                        android:textSize="24sp"
                        android:visibility="gone"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/myWalkProgress" />

                    <com.flipsidegroup.active10.utils.WalkingPlanHorseshoe
                        android:id="@+id/myWalkProgress"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_gravity="center"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/noBriskMessageTv"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/no_brisk_bg"
                        android:fontFamily="@font/roboto_bold"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="@string/no_walk_today"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/myWalkProgress"
                        app:layout_constraintEnd_toEndOf="@id/myWalkProgress"
                        app:layout_constraintStart_toStartOf="@id/myWalkProgress"
                        app:layout_constraintTop_toTopOf="@id/myWalkProgress"
                        tools:visibility="gone" />

                    <TextView
                        android:id="@+id/currentProgressValueTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-12dp"
                        android:fontFamily="@font/roboto_condensed_bold"
                        android:importantForAccessibility="no"
                        android:textColor="@color/black_33"
                        android:textSize="24sp"
                        app:layout_constraintEnd_toEndOf="@id/currentProgressTV"
                        app:layout_constraintStart_toStartOf="@id/currentProgressTV"
                        app:layout_constraintTop_toBottomOf="@id/myWalkProgress"
                        tools:text="2888 MINS" />

                    <TextView
                        android:id="@+id/currentProgressTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:fontFamily="@font/roboto_regular"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/black_33"
                        android:textSize="@dimen/text_size_16"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintEnd_toStartOf="@id/progressPlanGuideline"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/currentProgressValueTV"
                        tools:text="Brisk walking total" />

                    <TextView
                        android:id="@+id/maxProgressValueTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-12dp"
                        android:fontFamily="@font/roboto_condensed_bold"
                        android:importantForAccessibility="no"
                        android:textColor="@color/black_33"
                        android:textSize="24sp"
                        app:layout_constraintEnd_toEndOf="@id/maxProgressTV"
                        app:layout_constraintStart_toStartOf="@id/maxProgressTV"
                        app:layout_constraintTop_toBottomOf="@id/myWalkProgress"
                        tools:text="8888 MINS" />

                    <TextView
                        android:id="@+id/maxProgressTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:fontFamily="@font/roboto_regular"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/black_33"
                        android:textSize="@dimen/text_size_16"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/progressPlanGuideline"
                        app:layout_constraintTop_toBottomOf="@id/maxProgressValueTV"
                        tools:text="Brisk walking target" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/progressPlanGuideline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.5" />


                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/buttons_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/progress_layout">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/prev_button"
                        style="@style/OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="8dp"
                        android:text="Back"
                        android:textColor="@color/black"
                        app:icon="@drawable/ic_back_big"
                        app:iconGravity="textStart"
                        app:iconPadding="16dp"
                        app:iconTint="@color/black"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/next_button"
                        style="@style/OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="16dp"
                        android:text="Next"
                        android:textColor="@color/black"
                        app:icon="@drawable/ic_next_big"
                        app:iconGravity="textEnd"
                        app:iconPadding="16dp"
                        app:iconTint="@color/black"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/total_days_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="27dp"
                    android:background="@color/generic_bg_grey_card"
                    app:layout_constraintTop_toBottomOf="@id/buttons_container">

                    <com.phe.betterhealth.widgets.common.HeadingTextView
                        android:id="@+id/total_days_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginTop="27dp"
                        android:fontFamily="@font/roboto_condensed_bold"
                        android:importantForAccessibility="no"
                        android:text="Today’s progress"
                        android:textColor="@color/black_33"
                        android:textSize="18sp"
                        android:accessibilityHeading="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Today’s progress" />

                    <TextView
                        android:id="@+id/total_days_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/BU_15"
                        android:fontFamily="@font/roboto_family"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/black_33"
                        android:textSize="14sp"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/total_days_title"
                        tools:text="Day 1 of 7" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/day_progress_details_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/total_days_counter">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/briskCV"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="@dimen/card_radius"
                            app:cardElevation="1dp"
                            app:cardUseCompatPadding="true">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:id="@+id/brisk_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto_condensed_bold"
                                    android:gravity="center"
                                    android:importantForAccessibility="no"
                                    android:text='@{String.valueOf(content.currentDayBriskMin) + " of " + String.valueOf(content.totalDayBriskMin) + " mins"}'
                                    android:textColor="@color/black_33"
                                    android:textSize="18sp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    tools:text="0 of 11 mins" />

                                <TextView
                                    android:id="@+id/brisk_counter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="@dimen/BU_15"
                                    android:fontFamily="@font/roboto_regular"
                                    android:gravity="center"
                                    android:importantForAccessibility="no"
                                    android:text="@string/brisk_walking"
                                    android:textColor="@color/black_33"
                                    android:textSize="14sp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/brisk_title" />
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/nonBriskCV"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="@dimen/card_radius"
                            app:cardElevation="1dp"
                            app:cardUseCompatPadding="true"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/briskCV"
                            app:layout_constraintTop_toBottomOf="@id/total_days_counter"
                            app:strokeColor="@color/light_grey_two">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:id="@+id/non_brisk_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start"
                                    android:fontFamily="@font/roboto_condensed_bold"
                                    android:importantForAccessibility="no"
                                    android:text='@{String.valueOf(content.currentDayNonBriskMin) + " of " + String.valueOf(content.totalDayBriskMin) + " mins"}'
                                    android:textColor="@color/black_33"
                                    android:textSize="18sp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    tools:text="0 of 11 mins" />

                                <TextView
                                    android:id="@+id/non_brisk_counter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="@dimen/BU_15"
                                    android:fontFamily="@font/roboto_regular"
                                    android:gravity="center"
                                    android:importantForAccessibility="no"
                                    android:text="Non-brisk walking"
                                    android:textColor="@color/black_33"
                                    android:textSize="14sp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/non_brisk_title" />
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/day_no_targets_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="10dp"
                        android:orientation="vertical"
                        android:visibility="invisible"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/total_days_counter">

                        <TextView
                            android:id="@+id/day_no_targets_text1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/BU_15"
                            android:layout_marginVertical="4dp"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center"
                            android:text="@string/time_to_relax_no_targets_for_today"
                            android:textColor="@color/black_33"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/day_no_targets_text2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/BU_15"
                            android:layout_marginVertical="4dp"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center"
                            android:text="@string/check_back_in_tomorrow"
                            android:textColor="@color/black_33"
                            android:textSize="14sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <ImageView
                    android:id="@+id/icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="-27dp"
                    android:src='@{content.state == WalkingPlanState.ACTIVE ? @drawable/ic_walking_plan_statistics : @drawable/ic_walking_plan_statistics_grey}'
                    app:layout_constraintBottom_toTopOf="@id/total_days_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:src="@drawable/ic_walking_plan_statistics" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
