<?xml version="1.0" encoding="utf-8"?>
<layout>
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/titleTV"
            style="@style/HeaderMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/labelTV"
            style="@style/Description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_size_6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleTV"
            tools:lines="3"
            tools:text="@tools:sample/lorem/random" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputET"
            style="@style/AppTheme.Input.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="40dp"
            android:textSize="@dimen/text_size_16"
            app:errorEnabled="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelTV">

            <EditText
                android:id="@+id/valueET"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:background="@null"
                android:focusable="false"
                android:fontFamily="@font/roboto_medium"
                android:importantForAutofill="no"
                android:inputType="none"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/BU_12"
                android:paddingVertical="@dimen/BU_16"
                android:textColor="@color/input_text_title"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/text_size_16"
                tools:text="33" />

        </com.google.android.material.textfield.TextInputLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>