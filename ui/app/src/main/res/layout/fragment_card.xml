<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#efefef"
    android:orientation="vertical"
    tools:context="com.phe.betterhealth.demo.views.CardDemo"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingVertical="10dp">

        <com.phe.betterhealth.widgets.card.BHCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            app:cardFooterButtonContentDescription="View all motivations"
            app:cardFooterButtonText="View all"
            app:cardHeaderDescription="A reminder of why you want to quit"
            app:cardHeaderTitle="Your Motivations">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Lorem ipsum dolor sit amet" />
        </com.phe.betterhealth.widgets.card.BHCardView>

        <com.phe.betterhealth.widgets.card.BHCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            app:cardHeaderTitle="Only header">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Lorem ipsum dolor sit amet" />
        </com.phe.betterhealth.widgets.card.BHCardView>

        <com.phe.betterhealth.widgets.card.BHCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            app:cardHeaderDescription="Only description">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Lorem ipsum dolor sit amet" />
        </com.phe.betterhealth.widgets.card.BHCardView>

        <com.phe.betterhealth.widgets.card.BHCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Lorem ipsum dolor sit amet" />
        </com.phe.betterhealth.widgets.card.BHCardView>

        <com.phe.betterhealth.widgets.card.BHCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            app:cardFooterButtonText="Footer button from library">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    style="@style/Widget.BetterHealth.CardHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/card_custom_title"
                        style="@style/Widget.BetterHealth.CardHeaderTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Fully Custom header"
                        android:textAlignment="center"
                        android:textColor="@android:color/holo_blue_dark"
                        app:layout_constraintEnd_toStartOf="@id/card_custom_image"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        style="@style/Widget.BetterHealth.CardHeaderDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fruktur_regular"
                        android:text="based on library styles"
                        android:textAlignment="center"
                        app:layout_constraintEnd_toStartOf="@id/card_custom_image"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/card_custom_title" />

                    <ImageView
                        android:id="@+id/card_custom_image"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_my_walk_selector"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="ContentDescription" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:text="Lorem ipsum dolor sit amet" />

            </LinearLayout>
        </com.phe.betterhealth.widgets.card.BHCardView>
    </LinearLayout>
</ScrollView>
