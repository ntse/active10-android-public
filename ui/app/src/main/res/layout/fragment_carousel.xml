<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fff"
    android:orientation="vertical"
    android:padding="10dp"
    tools:context="com.phe.betterhealth.demo.views.CarouselDemo"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/view_pager_compose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.BetterHealth.InputLayout.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Example ViewPager 00" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager00"
                android:layout_width="match_parent"
                android:layout_height="300dp" />

            <com.phe.betterhealth.widgets.carousel.BHCarouselIndicator
                android:id="@+id/bh_indicator00"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.BetterHealth.InputLayout.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Example ViewPager 1" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager1"
                android:layout_width="match_parent"
                android:layout_height="300dp" />

            <com.phe.betterhealth.widgets.carousel.BHCarouselIndicator
                android:id="@+id/bh_indicator1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.BetterHealth.InputLayout.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Example RecyclerView 1" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view1"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_carousel_recyclerview" />

            <com.phe.betterhealth.widgets.carousel.BHCarouselIndicator
                android:id="@+id/bh_indicator11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.BetterHealth.InputLayout.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Example double RecyclerView 1" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view0"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_carousel_recyclerview_large" />

            <com.phe.betterhealth.widgets.carousel.BHCarouselIndicator
                android:id="@+id/bh_indicator0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.BetterHealth.InputLayout.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Example 2" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager2"
                android:layout_width="match_parent"
                android:layout_height="300dp" />

            <com.phe.betterhealth.widgets.carousel.BHCarouselIndicator
                android:id="@+id/bh_indicator2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.BetterHealth.InputLayout.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Example 3" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager3"
                android:layout_width="match_parent"
                android:layout_height="300dp" />

            <com.phe.betterhealth.widgets.carousel.BHCarouselIndicator
                android:id="@+id/bh_indicator3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.BetterHealth.InputLayout.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Example 4" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager4"
                android:layout_width="match_parent"
                android:layout_height="300dp" />

            <com.phe.betterhealth.widgets.carousel.BHCarouselIndicator
                android:id="@+id/bh_indicator4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>


</ScrollView>
