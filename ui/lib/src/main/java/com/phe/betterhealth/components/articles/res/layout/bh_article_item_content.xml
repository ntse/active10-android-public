<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.phe.betterhealth.components.articles.ArticleAdapter">

    <data>

        <variable
            name="content"
            type="String" />

        <variable
            name="isLast"
            type="boolean" />
    </data>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="?bhArticleCardContentStyle"
        android:background="@android:color/white"
        android:elevation="5dp"
        android:paddingHorizontal="22dp"
        android:paddingTop="3dp"
        android:textColor="@color/bhTextPrimary"
        android:textColorLink="?colorPrimary"
        app:lineHeight="24sp"
        app:paddingBottom="@{isLast ? 36f : 3f}"
        app:textHtml="@{content}"
        tools:lines="3"
        tools:paddingBottom="36dp"
        tools:text="@tools:sample/lorem/random" />
</layout>
