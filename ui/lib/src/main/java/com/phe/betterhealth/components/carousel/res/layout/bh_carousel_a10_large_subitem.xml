<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.modules.general.GeneralScreenAdapter">

    <data>

        <variable
            name="imageUrl"
            type="String" />

        <variable
            name="categoryLabel"
            type="String" />

        <variable
            name="bodyTitle"
            type="String" />

        <variable
            name="bodyDescription"
            type="String" />

        <variable
            name="buttonTitle"
            type="String" />

        <variable
            name="contentDescription"
            type="String" />

        <variable
            name="isCompleted"
            type="Boolean" />

        <variable
            name="hideImage"
            type="Boolean" />

        <variable
            name="isAttachedToRecyclerView"
            type="Boolean" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="5dp"
        android:contentDescription="@{contentDescription}"
        app:cardCornerRadius="10dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/thumb"
                android:layout_width="match_parent"
                android:layout_height="192dp"
                android:background="@android:color/darker_gray"
                android:scaleType="centerCrop"
                android:visibility="@{!hideImage}"
                app:layout_constraintTop_toTopOf="parent"
                app:srcUrl="@{imageUrl}"
                tools:ignore="ContentDescription"
                tools:src="@tools:sample/backgrounds/scenic" />

            <View
                android:id="@+id/mission_completed_overlay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:alpha="0.51"
                android:background="?colorPrimary"
                android:visibility="@{isCompleted &amp;&amp; !hideImage}"
                app:layout_constraintBottom_toBottomOf="@id/thumb"
                app:layout_constraintEnd_toEndOf="@id/thumb"
                app:layout_constraintStart_toStartOf="@id/thumb"
                app:layout_constraintTop_toTopOf="@id/thumb" />

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/bh_ic_mission_completed"
                android:visibility="@{isCompleted &amp;&amp; !hideImage}"
                app:layout_constraintBottom_toBottomOf="@id/mission_completed_overlay"
                app:layout_constraintEnd_toEndOf="@id/mission_completed_overlay"
                app:layout_constraintStart_toStartOf="@id/mission_completed_overlay"
                app:layout_constraintTop_toTopOf="@id/mission_completed_overlay"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/category"
                style="?bhArticleCardSubtitleStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:text="@{categoryLabel}"
                android:textColor="@color/bhTextSecondary"
                app:layout_constraintTop_toBottomOf="@id/thumb"
                tools:text="Advice and Support" />

            <TextView
                android:id="@+id/title"
                style="?bhArticleCardTitleStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/roboto_bold"
                android:text="@{bodyTitle}"
                android:textColor="@color/bhTextPrimary"
                app:layout_constraintTop_toBottomOf="@id/category"
                app:lineHeight="24sp"
                tools:text="Coping with cravings" />

            <TextView
                android:id="@+id/description"
                style="@style/Widget.TextView.Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="17dp"
                android:contentDescription="@{bodyDescription}"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="2"
                android:text="@{bodyDescription}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/title"
                app:layout_constraintVertical_bias="0"
                tools:text="@tools:sample/lorem/random" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
