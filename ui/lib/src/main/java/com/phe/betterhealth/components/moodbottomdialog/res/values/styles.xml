<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.BetterHealth.MoodBottomDialogCardStyle" parent="@style/Widget.MaterialComponents.CardView">
        <item name="shapeAppearanceOverlay">@style/Widget.BetterHealth.MoodBottomDialogCard</item>
    </style>

    <style name="Widget.BetterHealth.MoodBottomDialogCard" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="Widget.BetterHealth.MoodBottomDialogStyle" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">
            @style/Widget.BetterHealth.MoodBottomDialogStyle.CustomBottomSheetStyle
        </item>
    </style>

    <style name="Widget.BetterHealth.MoodBottomDialogStyle.CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Widget.BetterHealth.MoodBottomDialogStyle.RelatedArticleImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">7%</item>
    </style>
</resources>
