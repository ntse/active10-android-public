<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.BetterHealth.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/bhWhite</item>
        <item name="itemIconTint">@color/bh_nav_item_icon_color_state</item>
        <item name="itemTextColor">@color/bh_nav_item_text_color_state</item>
        <item name="itemTextAppearanceActive">
            @style/Widget.BetterHealth.BottomNavigation.Text.Active
        </item>
        <item name="itemTextAppearanceInactive">@style/Widget.BetterHealth.BottomNavigation.Text
        </item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.BetterHealth.BottomNavigation.Text">
        <item name="android:textSize">@dimen/bottom_navigation_text_size</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.BetterHealth.BottomNavigation.Text.Active">
        <item name="android:textSize">@dimen/bottom_navigation_text_size</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

</resources>
