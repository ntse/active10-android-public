<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.BetterHealth.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">10dp</item>
    </style>

    <style name="Widget.BetterHealth.CardHeader">
        <item name="android:background">@color/bhCardHeaderBackground</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingLeft">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.BetterHealth.CardHeaderTitle">
        <item name="android:fontFamily">@font/roboto_condensed_bold</item>
        <item name="android:textSize">@dimen/card_header_text_size</item>
    </style>

    <style name="Widget.BetterHealth.CardHeaderDescription">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">@dimen/card_header_description_text_size</item>
        <item name="android:lineHeight">@dimen/card_header_description_line_height</item>
    </style>

    <style name="Widget.BetterHealth.CardHeaderInfo">
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">@dimen/card_header_info_text_size</item>
    </style>

    <style name="Widget.BetterHealth.CardFooterButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="icon">@drawable/bh_chevron_right</item>
        <item name="strokeWidth">0dp</item>
        <item name="iconGravity">end</item>
        <item name="iconPadding">8dp</item>
    </style>
</resources>
