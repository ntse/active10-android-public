<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.phe.betterhealth.components.articles.ArticleAdapterWlp">

    <data>

        <variable
            name="heading"
            type="String" />

        <variable
            name="body"
            type="String" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        android:orientation="vertical">

        <com.phe.betterhealth.widgets.common.HeadingTextView
            android:id="@+id/article_related_heading_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bhArticleWlpBackground"
            android:elevation="5dp"
            android:focusable="true"
            android:fontFamily="@font/roboto_condensed_bold"
            android:paddingHorizontal="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="@{heading}"
            android:textColor="@color/bhTextPrimary"
            android:textSize="23sp"
            tools:lines="2"
            tools:text="@tools:sample/lorem/random" />

        <TextView
            android:id="@+id/article_related_content_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bhArticleWlpBackground"
            android:elevation="5dp"
            android:focusable="true"
            android:fontFamily="@font/roboto_regular"
            android:lineSpacingExtra="6sp"
            android:paddingHorizontal="14dp"
            android:paddingTop="3dp"
            android:paddingBottom="18dp"
            android:text="@{body}"
            android:textColor="@color/bhTextPrimary"
            android:textColorLink="?colorPrimary"
            android:textSize="15sp"
            tools:lines="3"
            tools:text="@tools:sample/lorem/random" />


    </LinearLayout>

</layout>
