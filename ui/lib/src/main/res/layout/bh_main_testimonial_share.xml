<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="bodyTitle"
            type="String"/>

        <variable
            name="author"
            type="String"/>

        <variable
            name="yearsSmoked"
            type="String"/>

        <variable
            name="hardestPart"
            type="String" />

        <variable
            name="topTip"
            type="String" />

        <variable
            name="lifeImproved"
            type="String" />

        <variable
            name="progressSoFar"
            type="String" />

        <variable
            name="onButtonClick"
            type="android.view.View.OnClickListener" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/bhTextPrimary"
                android:textSize="26sp"
                android:text="@{bodyTitle}"
                tools:text="I don’t have cravings anymore!" />

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/author_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:flexWrap="wrap"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/user_nickname"
                    style="?bhArticleCardContentStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="start"
                    android:maxLines="1"
                    android:text="@{author}"
                    android:textColor="@color/bhTextSecondary"
                    tools:text="John Snow" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/left_border_blue"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/bh_calendar_icon" />

                    <TextView
                        android:id="@+id/smoke_years"
                        style="?bhArticleCardContentStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/roboto_bold"
                        android:text="@{yearsSmoked}"
                        android:textColor="@color/bhTextSecondary"
                        tools:text="Smoked for 20 years" />

                </LinearLayout>

            </com.google.android.flexbox.FlexboxLayout>

            <TextView
                android:id="@+id/hardest_part_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/bhTextPrimary"
                android:textSize="20sp"
                android:text="What I found hard"
                tools:text="What I found hard" />

            <TextView
                android:id="@+id/hardest_part_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/roboto_regular"
                android:textColor="@color/bhTextSecondary"
                android:textSize="16sp"
                android:text="@{hardestPart}"
                tools:text="I was 18 when I started smoking. I’d been a smoker for 20 years... so it was time to stop. The hardest bit is deciding and keeping a ‘I’m not a smoker’ mindset." />

            <TextView
                android:id="@+id/top_tip_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/bhTextPrimary"
                android:textSize="20sp"
                android:text="My top tip"
                tools:text="My top tip" />

            <TextView
                android:id="@+id/top_tip_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/roboto_regular"
                android:textColor="@color/bhTextSecondary"
                android:textSize="16sp"
                android:text="@{topTip}"
                tools:text="The thing that I did most to support myself was to break the routines of smoking – I avoided smoking after a meal, after a commute, or out with friends." />

            <TextView
                android:id="@+id/life_improved_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/bhTextPrimary"
                android:textSize="20sp"
                android:text="How my life’s improved"
                tools:text="How my life’s improved" />

            <TextView
                android:id="@+id/life_improved_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/roboto_regular"
                android:textColor="@color/bhTextSecondary"
                android:textSize="16sp"
                android:text="@{lifeImproved}"
                tools:text="I’m breathing easier, my cough has improved greatly and, as a bonus, I’m £80 a month better off!" />

            <TextView
                android:id="@+id/progress_so_far_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/bhTextPrimary"
                android:textSize="20sp"
                android:text="My progress so far"
                tools:text="My progress so far" />

            <TextView
                android:id="@+id/progress_so_far_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/roboto_regular"
                android:textColor="@color/bhTextSecondary"
                android:textSize="16sp"
                android:text="@{progressSoFar}"
                tools:text="Dealing with daily stress was difficult, and parts of the day where I would smoke to relax. I learnt to deep breath or walked to take my mind off cravings." />
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
