<resources>

    <style name="Theme.BetterHealth" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">#FFC107</item>
        <!--        <item name="colorSecondary">@color/my_app_secondary_color</item>-->
        <!--        <item name="android:colorBackground">@color/my_app_background_color</item>-->
        <item name="colorError">@color/bhInputBorderError</item>

        <!--        <item name="colorPrimaryVariant">@color/my_app_primary_variant_color</item>-->
        <!--        <item name="colorSecondaryVariant">@color/my_app_secondary_variant_color</item>-->
        <!--        <item name="colorSurface">@color/my_app_surface_color</item>-->
        <!--        <item name="colorOnPrimary">@color/my_app_color_on_primary</item>-->
        <!--        <item name="colorOnSecondary">@color/my_app_color_on_secondary</item>-->
        <!--        <item name="colorOnBackground">@color/my_app_color_on_background</item>-->
        <!--        <item name="colorOnError">@color/my_app_color_on_error</item>-->
        <item name="colorOnSurface">#000</item>
        <item name="scrimBackground">@color/mtrl_scrim_color</item>

        <item name="colorPrimaryDark">@color/bhInputBorder</item>
        <item name="colorAccent">@color/bhInputBorderFocus</item>

        <item name="bhButtonStyle">@style/Widget.BetterHealth.Button.Medium</item>
        <item name="bhCheckBoxStyle">@style/Widget.BetterHealth.Checkbox</item>
        <item name="bhCheckBoxLayoutStyle">@style/Widget.BetterHealth.CheckboxLayout</item>
        <item name="bhCheckBoxLayoutErrorStyle">@style/Widget.BetterHealth.CheckboxLayoutError
        </item>
        <item name="bhTextInputLayoutStyle">@style/Widget.BetterHealth.InputLayout.Medium</item>
        <item name="bhTextInputLayoutTitleStyle">
            @style/Widget.BetterHealth.InputLayout.Title.Medium
        </item>
        <item name="bhTextInputEditTextStyle">@style/Widget.BetterHealth.EditText.Medium</item>
        <item name="bhSpinnerStyle">@style/Widget.BetterHealth.EditText.Spinner</item>
        <item name="bhRadioButtonStyle">@style/Widget.BetterHealth.RadioButton</item>
        <item name="bhRadioGroupErrorStyle">@style/Widget.BetterHealth.CheckboxLayoutError</item>
        <item name="bhBottomNavigationStyle">@style/Widget.BetterHealth.BottomNavigation</item>
        <item name="bhCardStyle">@style/Widget.BetterHealth.Card</item>
        <item name="bhCardHeaderStyle">@style/Widget.BetterHealth.CardHeader</item>
        <item name="bhCardHeaderTitleStyle">@style/Widget.BetterHealth.CardHeaderTitle</item>
        <item name="bhCardHeaderInfoStyle">@style/Widget.BetterHealth.CardHeaderInfo</item>
        <item name="bhCardHeaderDescriptionStyle">@style/Widget.BetterHealth.CardHeaderDescription
        </item>
        <item name="bhCardFooterButtonStyle">@style/Widget.BetterHealth.CardFooterButton</item>
        <item name="bhPagerIndicatorButtonStyle">@style/Widget.BetterHealth.PagerIndicator</item>
        <item name="bhSettingsPrimaryTextStyle">@style/Widget.BetterHealth.Settings.PrimaryText</item>
        <item name="bhSettingsSecondaryTextStyle">@style/Widget.BetterHealth.Settings.SecondaryText</item>
        <item name="alertDialogTheme">@style/Widget.BetterHealth.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/Widget.BetterHealth.MaterialAlertDialog</item>
        <item name="materialCalendarTheme">@style/Widget.BetterHealth.MaterialCalendar</item>

        <item name="bhArticleCardSubtitleStyle">@style/Widget.BetterHealth.ArticleCard.Subtitle</item>
        <item name="bhArticleCardTitleStyle">@style/Widget.BetterHealth.ArticleCard.Title</item>
        <item name="bhArticleCardContentStyle">@style/Widget.BetterHealth.ArticleCard.Content</item>
        <item name="bhArticleCardHeaderStyle">@style/Widget.BetterHealth.ArticleCard.Header</item>

    </style>

    <style name="Widget.BetterHealth.AlertDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="fontFamily">@font/roboto_regular</item>
    </style>

    <style name="Widget.BetterHealth.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="materialAlertDialogBodyTextStyle">@style/Widget.BetterHealth.MaterialAlertDialog.Body</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.BetterHealth.MaterialAlertDialog.Title</item>
    </style>

    <style name="Widget.BetterHealth.MaterialAlertDialog.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="fontFamily">@font/roboto_regular</item>
    </style>

    <style name="Widget.BetterHealth.MaterialAlertDialog.Body" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="fontFamily">@font/roboto_regular</item>
    </style>

    <style name="Widget.BetterHealth.MaterialCalendar" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="android:textAppearanceSmall">@font/roboto_regular</item>
        <item name="android:textAppearanceMedium">@font/roboto_bold</item>
        <item name="android:textAppearanceLarge">@font/roboto_condensed_bold</item>
    </style>

    <style name="Theme.BetterHealth.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Widget.BetterHealth" parent="Theme.BetterHealth" />


    <style name="ShapeAppearanceOverlay.App.CornerSize10dp" parent="">
        <item name="cornerSize">10dp</item>
    </style>


    <!--  Text  -->

    <style name="Widget.TextView" parent="Theme.BetterHealth.NoActionBar" />

    <style name="Widget.TextView.Header">
        <item name="android:fontFamily">@font/roboto_condensed_bold</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textColor">@color/bhTextPrimary</item>
        <item name="android:textSize">@dimen/onboarding_title_text_size</item>
    </style>

    <style name="Widget.TextView.Content">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textColor">@color/bhTextSecondary</item>
        <item name="android:textSize">@dimen/text_size_regular</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="lineHeight">24sp</item>
    </style>

    <style name="Widget.TextView.ListItem" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textColor">@color/bhTextPrimary</item>
        <item name="android:textSize">@dimen/text_size_regular</item>
        <item name="drawableEndCompat">@drawable/bh_chevron_right</item>

        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:paddingTop">27dp</item>
        <item name="android:paddingBottom">17dp</item>
        <item name="android:gravity">center_vertical</item>

        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Button.Back" parent="Theme.BetterHealth">
        <item name="android:layout_marginStart">17dp</item>

        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/bhTextPrimary</item>
        <item name="icon">@drawable/bh_ic_back</item>
        <item name="android:textSize">@dimen/onboarding_content_text_size</item>
        <item name="iconPadding">17dp</item>
        <item name="iconTint">@color/bhTextPrimary</item>
    </style>

    <style name="Widget.Button.Back.Inverted">
        <item name="android:textColor">@android:color/white</item>
        <item name="iconTint">@android:color/white</item>
    </style>

    <style name="Widget.Button.Primary" parent="Widget.BetterHealth.Button.Large.Filled">
        <item name="android:layout_marginBottom">25dp</item>
        <item name="android:layout_marginTop">25dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">22dp</item>
        <item name="android:textSize">@dimen/onboarding_content_text_size</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Button.Secondary" parent="Widget.BetterHealth.Button.Large.Outline">
        <item name="android:layout_marginBottom">17dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingBottom">22dp</item>
        <item name="android:textSize">@dimen/onboarding_content_text_size</item>
    </style>

    <style name="Widget.Button.MoodChooser" parent="Widget.BetterHealth.Button.Large.Outline">
        <item name="iconTint">@null</item>
        <item name="iconSize">50dp</item>
        <item name="iconGravity">textStart</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:paddingStart">5dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:gravity">start|center</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <style name="Widget.TextView.StreakCardTileTitle">
        <item name="android:textSize">@dimen/onboarding_content_text_size</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginBottom">1dp</item>
        <item name="android:textColor">@color/bhTextPrimary</item>
    </style>

    <style name="Widget.TextView.StreakCardTileDescription">
        <item name="android:textSize">@dimen/onboarding_content_text_size</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/bhTextSecondary</item>
    </style>

    <style name="Widget.BetterHealth.Input.CounterTextAppearance" parent="@android:style/TextAppearance">
        <item name="android:textSize">13sp</item>
    </style>

</resources>
